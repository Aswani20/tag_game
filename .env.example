# Copy to .env for npm start. Hosting providers can supply these directly.
HOST=0.0.0.0
PORT=3001
# Leave empty for one public HTTPS service. For separate hosts, use exact origins.
CLIENT_ORIGIN=
# Runtime browser-facing backend origin, served by Node in /tag-config.js
PUBLIC_SERVER_URL=
# Alternative build-time backend origin for a separately hosted static frontend
VITE_SERVER_URL=
